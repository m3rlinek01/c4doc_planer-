# Konfiguracja C4 GuestPass na serwerze Linux: /etc/c4guestpass/c4guestpass.env (prawa 600, właściciel root).
# Po zmianie: sudo systemctl restart c4guestpass
#
# Wartości ze znakami specjalnymi (spacja, $, #, ", \) wpisuj w apostrofach: Mail__Password='a$b#c'.
# Połączenie z C4 (adres, login, hasło) można też ustawić później w przeglądarce:
# Konfiguracja C4 → Połączenie z C4. Ustawienie z aplikacji ma pierwszeństwo przed wartościami poniżej.

# --- serwer WWW ---------------------------------------------------------------------------------
# Za reverse proxy (Caddy/nginx na tym samym serwerze) aplikacja słucha tylko lokalnie.
ASPNETCORE_URLS=http://127.0.0.1:8080
ASPNETCORE_ENVIRONMENT=Production
# Uwzględnij X-Forwarded-Proto/For od reverse proxy (https -> ciasteczko Secure, IP klienta w logach).
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true
# Ciasteczko logowania tylko po HTTPS. false wyłącznie przy dostępie bez HTTPS (test, zaufana sieć).
GuestPass__SecureCookies=true
GuestPass__SiteName='Wise Point · Recepcja'
TZ=Europe/Warsaw

# --- dane (baza SQLite, klucze szyfrujące, poczta w trybie Pickup) --------------------------------
GuestPass__DatabasePath=/var/lib/c4guestpass/guestpass.db
Mail__PickupDirectory=/var/lib/c4guestpass/mail

# --- Gamanet C4 ---------------------------------------------------------------------------------
# SimpleClient = prawdziwy C4 (paczka zbudowana z C4 SDK 2024); Mock = demo bez C4.
C4__Mode=SimpleClient
# Adres serwera C4 widziany z TEGO serwera (bez /c4 na końcu). Wymagany dostęp do portu 443 serwera C4.
C4__ServerUri=https://c4server.firma.local
C4__User=
C4__Password=

# --- poczta z zaproszeniami ---------------------------------------------------------------------
# Smtp = wysyłka; Pickup = zapis plików .eml do Mail__PickupDirectory (test).
Mail__Mode=Smtp
Mail__Host=smtp.firma.pl
Mail__Port=587
Mail__UseStartTls=true
Mail__User=
Mail__Password=
Mail__FromAddress=recepcja@firma.pl
Mail__FromName=Recepcja

# --- pierwsze uruchomienie ----------------------------------------------------------------------
# Konto administratora budynku. Puste hasło = losowe hasło tymczasowe w logu:
#   journalctl -u c4guestpass | grep -i hasło
Bootstrap__AdminLogin=admin
Bootstrap__AdminPassword=
