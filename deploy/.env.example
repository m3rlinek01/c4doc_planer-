# Skopiuj do deploy/.env (plik jest w .gitignore) i uzupełnij. Używane przez docker-compose.yml.

# --- budowanie obrazu ---
# None = tylko symulacja C4 (demo); 2024 / 2026 = Gamanet Simple Client SDK zgodny z wersją serwera C4
C4_SDK_VERSION=None
# Opcjonalnie dokładna wersja pakietów, np. 2024.0.0.512
C4_SDK_PACKAGE_VERSION=

# --- aplikacja ---
APP_PORT=8080

# --- sekrety (pozostałe ustawienia: deploy/appsettings.Production.json) ---
# Hasło operatora technicznego C4 (C4:User)
C4_PASSWORD=
# Hasło konta SMTP (Mail:User)
MAIL_PASSWORD=
# Hasło startowe administratora budynku. Puste = losowe hasło tymczasowe wypisane w logu (zalecane),
# zmiana wymuszana przy pierwszym logowaniu. Używane tylko, gdy baza nie ma jeszcze żadnych kont.
BOOTSTRAP_ADMIN_PASSWORD=

# --- Caddy (profil https) ---
GUESTPASS_DOMAIN=guestpass.firma.pl
ACME_EMAIL=it@firma.pl
